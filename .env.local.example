# --- Vercel Postgres ---
# Skopiuj wartosci z panelu Vercel: Storage -> (Twoja baza) -> .env.local
# Wystarczy POSTGRES_URL; pozostale sa opcjonalne.
POSTGRES_URL=

# --- Ochrona dostepu (opcjonalna) ---
# Jesli ustawisz haslo, cala aplikacja bedzie za ekranem logowania.
# Zostaw puste podczas lokalnego developmentu, jesli nie chcesz gate'a.
DASHBOARD_PASSWORD=

# --- Rekomendacje US (Faza 2): darmowy klucz z finnhub.io ---
# Bez klucza rekomendacje US sa pomijane (PL dziala bez klucza).
FINNHUB_API_KEY=

# --- Cron (opcjonalne): zabezpiecza GET /api/recommendations/refresh ---
# Vercel Cron dostarcza naglowek Authorization: Bearer <CRON_SECRET> automatycznie.
CRON_SECRET=

# --- Klucz do analizy AI (przyda sie w Fazie 4/5) ---
ANTHROPIC_API_KEY=

# Model Anthropic (opcjonalnie). Domyslnie tani i szybki claude-haiku-4-5.
# Dla wyzszej jakosci np. claude-opus-5.
ANTHROPIC_MODEL=
